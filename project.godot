; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="snow_prototype"
run/main_scene="uid://dw2bem4t82aw7"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

SnowComputeManager="*uid://f2ykbk33cplf"
SnowSurfaceManager="*uid://y5tou42hvelt"
SnowSurfaceThreadManager="*uid://c2cnynv55euhd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/always_on_top=true
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="snow_prototype"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/dynamic_interactible_snow/plugin.cfg")

